# Copy to secrets.yaml and fill in. secrets.yaml is gitignored and must never
# be committed. Every key here is referenced by !secret in cores3-bringup.yaml.

wifi_ssid: "your-network"
wifi_password: "your-psk"

# 32 random bytes, base64. Generate with:
#   head -c 32 /dev/urandom | base64
api_key: "REPLACE-ME-32-BYTE-BASE64-KEY"

ota_password: "choose-an-ota-password"
